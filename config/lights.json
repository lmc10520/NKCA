  "headlight": "#fff6dd",
  "taillight": "#ff3b2f",
  "groundGlow": 0.4,
  "_說明": "headlight／taillight＝車燈顏色；groundGlow＝夜間車燈照在路面的光暈強度（0–1）"
 },
 "markings": [
  {
   "_說明": "道路標線夜間自發光（白線、黃線）。intensity 越小越暗，0＝不發光；超過約 0.6 會被夜間光暈（bloom）放大",
   "match": "^Site_Marking_White",
   "color": "#e8eef5",
   "intensity": 0.3
  },
  {
   "match": "^Site_Marking_Yellow",
   "color": "#ffc94a",
   "intensity": 0.35
  }
 ],
 "buildingHours": {
  "_說明": "建築燈光（玻璃、天窗、露臺、戶外劇場、榕樹廣場、屋頂投射燈、草坪光環）的開燈時段；off 之後熄燈，on 之後天黑才會亮。路燈、車燈、道路標線不受影響。",
  "on": "05:00",
  "off": "23:00"
 }
