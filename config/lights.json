{
 "_說明": "夜間燈光。match 為物件名稱的正規表示式。intensity 是夜晚全開時的強度，白天自動淡出。",
 "glass": {
  "_說明": "所有玻璃帷幕由內往外的暖黃光",
  "color": "#fff1dc",
  "intensity": 0.9,
  "match": [
   "Glass",
   "^Door1F_.*_Glass",
   "Fascia_Glass"
  ],
  "exclude": [
   "^SK\\d+_Glass",
   "Escalator"
  ]
 },
 "skylights": {
  "_說明": "天窗下方透出的淡暖光",
  "color": "#fff6e8",
  "intensity": 0.5,
  "match": [
   "^SK\\d+_Glass"
  ]
 },
 "terraces": {
  "_說明": "三個鏤空露臺：只亮輪廓",
  "color": "#fff8ec",
  "match": [
   "^L3_Terrace$"
  ],
  "thresholdAngle": 35,
  "intensity": 0.8
 },
 "theaterSteps": {
  "_說明": "戶外劇場每一階燈條",
  "color": "#f4ede0",
  "match": [
   "^Theater_Seating$",
   "^Theater_Seating_Upper$"
  ],
  "minLength_m": 1.2,
  "intensity": 0.6
 },
 "plaza": {
  "_說明": "榕樹廣場天花的崁燈：天花上畫光點（不逐顆建燈），地面用一盞大面光源打出頂光",
  "ceilingMatch": [
   "^Plaza_Ceiling$"
  ],
  "dotSpacing_m": 3.2,
  "dotRadius_m": 0.09,
  "color": "#fff6ea",
  "area": {
   "_說明": "頂光範圍避開南側戶外劇場（座位會頂到天花附近，會被打成一片白）",
   "center_cm": [
    13800,
    16500,
    900
   ],
   "size_cm": [
    19000,
    10000
   ],
   "intensity": 0.7
  }
 },
 "floors": {
  "_說明": "樹冠大廳與廳院內的地板夜間照明：地板朝上的面整片均勻提亮成暖光（不建光源、不畫光點，手機與精簡模型都沒有額外負擔）。rules 每條為 match（物件名稱規則）＋ material（材質名稱正規表示式，可省略），符合任一條就亮。和其他建築燈光一樣，白天與熄燈後自動關掉。intensity 為地板被照亮的程度（底色 × 燈色 × intensity），本來就比這亮的白色座位不會再加亮。",
  "color": "#ffe6c4",
  "intensity": 0.6,
  "rules": [
   {
    "_說明": "樹冠大廳 3F：L3_ 開頭、材質 L3_Floor 的地板（L3_Floor (n)、L3_Floor_OH_Band、露臺等）；樓地板換成地毯後材質名稱為 Finish_Carpet（finishes.json）",
    "match": [
     "^L3_"
    ],
    "material": "^(L3_Floor|Finish_Carpet)$"
   },
   {
    "_說明": "歌劇院觀眾席與樓梯平台",
    "match": [
     "^OH_Aud_.*(Floor|Stalls|Tiers|Balcony)",
     "^OH_Stair_Landing_"
    ]
   },
   {
    "_說明": "各廳觀眾席、舞台；表演廳 1F／2F 樓板",
    "match": [
     "^Hall_.*_(Stalls|Balcony|Stage)$",
     "^RH[12]F_Floor$"
    ]
   }
  ]
 },
 "roofSpots": {
  "_說明": "屋頂投射燈（依 20261011_屋頂投射燈位置.pdf 的黃點自動換算）。pos_cm 的高度留 null 會自動貼在屋頂表面上方 60cm；dir_deg 為照射方向（0=東、90=北），燈會以低角度掠過屋面、凸顯起伏。max 為同時亮的上限，手機自動減半。",
  "max": 25,
  "color": "#fff6ea",
  "intensity": 150,
